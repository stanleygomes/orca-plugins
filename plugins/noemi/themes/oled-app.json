{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#000000",
    "--editor-surface": "#000000",
    "--foreground": "#f7f5ee",
    "--card": "#101010",
    "--card-foreground": "#f7f5ee",
    "--popover": "#101010",
    "--popover-foreground": "#f7f5ee",
    "--primary": "#ff9d6c",
    "--primary-foreground": "#000000",
    "--secondary": "#171717",
    "--secondary-foreground": "#f7f5ee",
    "--muted": "#171717",
    "--muted-foreground": "#b8b5ac",
    "--accent": "#342016",
    "--accent-foreground": "#ffffff",
    "--border": "#66615d",
    "--input": "#292929",
    "--ring": "#ff9d6c",
    "--sidebar": "#000000",
    "--sidebar-foreground": "#f7f5ee",
    "--sidebar-primary": "#ff9d6c",
    "--sidebar-primary-foreground": "#000000",
    "--sidebar-accent": "#342016",
    "--sidebar-accent-foreground": "#ffffff",
    "--sidebar-border": "#66615d",
    "--sidebar-ring": "#ff9d6c",
    "--worktree-sidebar": "#000000",
    "--worktree-sidebar-foreground": "#f7f5ee",
    "--worktree-sidebar-accent": "#342016",
    "--worktree-sidebar-accent-foreground": "#ffffff",
    "--worktree-sidebar-border": "#66615d",
    "--worktree-sidebar-ring": "#ff9d6c"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#77756e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.void",
        "keyword.operator.in",
        "keyword.operator.of",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff9d6c"
      }
    },
    {
      "name": "Keyword Control Flow",
      "scope": [
        "keyword.control.flow",
        "keyword.control.return",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#ff9d6c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.ternary",
        "keyword.operator.spread"
      ],
      "settings": {
        "foreground": "#9a988f"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#8fba6a"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4ec2c2"
      }
    },
    {
      "name": "Template Expression",
      "scope": [
        "punctuation.definition.template-expression",
        "string.template punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#ff9d6c"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex"
      ],
      "settings": {
        "foreground": "#e89b76"
      }
    },
    {
      "name": "Built-in Constant",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#e89b76",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Other Constant",
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#d4a06a"
      }
    },
    {
      "name": "Function Declaration",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b39cf5"
      }
    },
    {
      "name": "Method Call",
      "scope": [
        "meta.method-call entity.name.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#b39cf5"
      }
    },
    {
      "name": "Function Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#b7b5a6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#5cacde"
      }
    },
    {
      "name": "Type Parameter",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#4ec2c2"
      }
    },
    {
      "name": "Interface",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#4ec2c2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Enum",
      "scope": [
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#5cacde"
      }
    },
    {
      "name": "Type Annotation",
      "scope": [
        "meta.type.annotation",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#5cacde"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#c3c1ba"
      }
    },
    {
      "name": "Variable Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#c4a66e"
      }
    },
    {
      "name": "Variable Language (this, self)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#ff9d6c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9a988f"
      }
    },
    {
      "name": "Tag Name",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#ff9d6c"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b39cf5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Property",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#5cacde"
      }
    },
    {
      "name": "CSS Value",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#8fba6a"
      }
    },
    {
      "name": "CSS Selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#ff9d6c"
      }
    },
    {
      "name": "CSS Unit",
      "scope": [
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#e89b76"
      }
    },
    {
      "name": "JSON Key",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#c4a66e"
      }
    },
    {
      "name": "JSON String Value",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#8fba6a"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#ff9d6c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#5cacde"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#8fba6a"
      }
    },
    {
      "name": "Markdown List Marker",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#ff9d6c"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#77756e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "meta.decorator entity.name.function",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#9c87f6"
      }
    },
    {
      "name": "Module / Namespace",
      "scope": [
        "entity.name.type.module",
        "entity.name.type.namespace",
        "support.module"
      ],
      "settings": {
        "foreground": "#c4a66e"
      }
    },
    {
      "name": "Support Variable",
      "scope": [
        "support.variable",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e89b76"
      }
    },
    {
      "name": "Support Variable DOM",
      "scope": [
        "support.variable.dom",
        "support.constant.math",
        "support.constant.json"
      ],
      "settings": {
        "foreground": "#5cacde"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f14444"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#77756e",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
