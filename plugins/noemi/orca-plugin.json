{
  "manifestVersion": 2,
  "execution": "data",
  "id": "noemi",
  "publisher": "stanleygomes",
  "name": "Noemi Theme",
  "version": "1.1.1",
  "description": "Noemi colors for Orca, adapted from Noemi for VS Code.",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "themes": [
      {
        "id": "noemi-dark",
        "title": "Noemi Dark",
        "path": "themes/dark-app.json"
      },
      {
        "id": "noemi-light",
        "title": "Noemi Light",
        "path": "themes/light-app.json"
      },
      {
        "id": "noemi-oled",
        "title": "Noemi OLED",
        "path": "themes/oled-app.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "noemi-dark-terminal",
        "title": "Noemi Dark",
        "path": "themes/dark-terminal.json"
      },
      {
        "id": "noemi-light-terminal",
        "title": "Noemi Light",
        "path": "themes/light-terminal.json"
      },
      {
        "id": "noemi-oled-terminal",
        "title": "Noemi OLED",
        "path": "themes/oled-terminal.json"
      }
    ]
  },
  "capabilities": []
}
